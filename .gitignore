# IDE
.idea/

# Python bytecode
__pycache__/
*.py[cod]

# Virtual environments
.venv/

# Build / packaging
dist/
build/
*.egg-info/

# PyInstaller
# The spec file under packaging/ is checked in; ignore any spec generated at
# the repo root by an ad-hoc ``pyinstaller <script>`` invocation, plus the
# transient PyInstaller working directories.
/*.spec
*.manifest
pyinstaller-build/

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# Project-generated data
/RawRecordings/*
!/RawRecordings/.gitkeep
/Recordings/*
!/Recordings/.gitkeep
/tests/Recordings/*
!/tests/Recordings/.gitkeep
/measurement_positions.txt
tests/measurement_positions.txt
/measurement_positions.csv
docs/_build/
/measurements/
/config.old
/tests/Recordings/
